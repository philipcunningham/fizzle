{
  "name": "fizzle-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "protocol-check": "node scripts/check-protocol.mjs",
    "architecture-check": "node scripts/check-architecture.mjs",
    "bundle-check": "node scripts/check-bundle.mjs",
    "smoke": "node scripts/smoke.mjs",
    "docshots": "node scripts/docshots.mjs",
    "perf": "node scripts/perf-drag.mjs",
    "check": "npm run protocol-check && npm run architecture-check && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run bundle-check && npm run base-check",
    "check:fast": "npm run protocol-check && npm run architecture-check && npm run format:check && npm run lint && npm run typecheck",
    "visual": "node scripts/visual.mjs",
    "visual:update": "node scripts/visual.mjs --update",
    "base-check": "node scripts/check-base.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@tanstack/react-query": "^5.102.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wavesurfer.js": "^7.12.11"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "handlebars": "^4.7.9"
  }
}
