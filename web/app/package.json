{
  "name": "fizzle-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "protocol-check": "node scripts/check-protocol.mjs",
    "bundle-check": "node scripts/check-bundle.mjs",
    "smoke": "node scripts/smoke.mjs",
    "perf": "node scripts/perf-drag.mjs",
    "check": "npm run protocol-check && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run bundle-check && npm run base-check",
    "visual": "node scripts/visual.mjs",
    "visual:update": "node scripts/visual.mjs --update",
    "base-check": "node scripts/check-base.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-select": "^2.3.3",
    "@tanstack/react-query": "^5.62.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wavesurfer.js": "^7.12.10"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.17.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.61.1",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "handlebars": "^4.7.9"
  }
}
