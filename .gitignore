# Build outputs
/fizzle*

# FZ format artefacts generated during development/testing
*.img
*.fzv
*.fzf
*.wav

# Backup snapshots (e.g. JUNGLISM.img.bak)
*.bak

# Testdata assets are committed despite the above
!testdata/**

# Test coverage
coverage.out
coverage.html

# Profile artefacts produced by `make profile`
cpu.prof
mem.prof
*.test

# macOS
**/.DS_Store

# AI agent working directories: ignore everything except project skills
# and the shared hook configuration
.claude/*
!.claude/skills/
!.claude/settings.json

# Generated attribution (regenerated each `make build`)
/internal/licenses/THIRD_PARTY_LICENSES.txt
/internal/licenses/LICENSE.txt
/*.spdx.json

# Browser automation session artifacts (Playwright MCP)
.playwright-mcp/

# Web front end (npm / React / Vite), scoped under web/
node_modules/
web/**/dist/
web/**/dist-ssr/
web/**/coverage/
web/**/.vite/
web/**/*.local
web/**/.env
web/**/.env.*
!web/**/.env.example

# Playwright test artifacts
web/**/test-results/
web/**/playwright-report/

# Visual baseline mismatches, written by npm run visual on failure
web/app/visual/**/*.actual.png

# Browser core artefacts, regenerated by `make wasm`
web/app/src/core/fizzle.wasm
web/app/src/core/generated/

# Handoff docs stay local; only the directory marker is tracked
/handoffs/*
!/handoffs/.gitkeep

# npm / TypeScript / lint caches and logs
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
.stylelintcache
.npm
